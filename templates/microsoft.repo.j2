{{ ansible_managed | comment }}
# The same repository id as the file in Microsoft's packages-microsoft-prod package, so
# other roles or a manual setup update this definition instead of adding a second one.
[packages-microsoft-com-{{ __mde_linux_repo_channel }}]
name={{ __mde_linux_rpm_repo_names[__mde_linux_repo_channel] }}
baseurl={{ mde_linux_repository_url | regex_replace('/+$', '') }}/{{ __mde_linux_repository_path }}/{{ __mde_linux_repo_channel }}/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey={% for key in __mde_linux_gpg_keys %}file://{{ __mde_linux_rpm_key_dir }}/{{ key.file }}{{ ' ' if not loop.last }}{% endfor %}

sslverify=1
